# OpenAI 官方 API；使用兼容网关时替换 key 和 base URL。
DEVAGENT_LLM_API_KEY=
DEVAGENT_LLM_MODEL=gpt-5.6-luna
DEVAGENT_LLM_BASE_URL=https://api.openai.com/v1

# GPT Agent 工具调用推荐 responses；其他兼容供应商可使用 chat_completions。
DEVAGENT_LLM_API_MODE=responses
DEVAGENT_LLM_REASONING_EFFORT=medium

# GitHub App PR 建议模式；私钥文件和真实 secret 不进入仓库。
DEVAGENT_GITHUB_WEBHOOK_SECRET=
DEVAGENT_GITHUB_APP_CLIENT_ID=
DEVAGENT_GITHUB_APP_PRIVATE_KEY_PATH=
# 仅供显式 smoke probe 使用；正常 webhook 从 payload 读取 installation.id。
DEVAGENT_GITHUB_INSTALLATION_ID=
DEVAGENT_GITHUB_ALLOWED_REPOSITORY=owner/devagent-review-smoke
DEVAGENT_GITHUB_WORKSPACE=/absolute/path/to/devagent-review-smoke
DEVAGENT_GITHUB_API_BASE_URL=https://api.github.com
DEVAGENT_ENABLE_GITHUB_SMOKE=0
DEVAGENT_GITHUB_SMOKE_FIXED_LLM=0
